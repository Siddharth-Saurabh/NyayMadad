# NyayMadad Server Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nyaymadad?retryWrites=true&w=majority

# Redis (falls back gracefully to memory if Redis is unavailable locally)
REDIS_URL=redis://localhost:6379

# Clerk Authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# AI Configuration (mock | gemini)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-1.5-flash

# Storage Configuration (local | s3)
STORAGE_PROVIDER=local
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Identity Provider (mock | live)
IDENTITY_PROVIDER=mock

# Speech-to-Text Provider (mock | gemini)
SPEECH_PROVIDER=mock

# Client Web URL
CLIENT_URL=http://localhost:5173
